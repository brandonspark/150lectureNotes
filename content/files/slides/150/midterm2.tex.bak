\section*{Questions}

\begin{questions}

\titledquestion{Types and Values}
\textbf{Types and Values}

For each of the expressions below, write its \textbf{most general type} and value.

\textbf{If the expression is not well-typed then say so and explain your answer briefly.}

\textbf{If the expression does not evaluate to a value then say so and explain your answer briefly.}

\textbf{For brevity, if the expression is already a value, you may write out "same" for its value}.

\begin{parts}

  \part[2]\hfill

  \begin{codeblock}
    fn x => fn y => fn z =>
      if x then
        z (y, y)
      else
        z x
  \end{codeblock}

  \textbf{Type:} \begin{solutionorlines}[4em] NWT \end{solutionorlines}

  \textbf{Value:} \begin{solutionorlines}[4em] no value, not well typed \end{solutionorlines}

  \vspace{10pt}

  \part[2]\hfill

  \begin{codeblock}
    (fn x => fn y => fn z => (x ^ y, z y)) "here" "kitty"
  \end{codeblock}

  \textbf{Type:} \begin{solutionorlines}[4em] \code{(string -> 'a) -> (string * 'a)} \end{solutionorlines}

  \textbf{Value:} \begin{solutionorlines}[4em] \code{fn z => ("here" ^ "kitty", z "kitty")} \end{solutionorlines}

  \newpage

  \part[2]\hfill

  \begin{codeblock}
    foldr filter
  \end{codeblock}

  \textbf{Type:} \begin{solutionorlines}[4em] NWT \end{solutionorlines}

  \textbf{Value:} \begin{solutionorlines}[4em] no value \end{solutionorlines}

  \part[2]\hfill

  \begin{codeblock}
    let
      fun f (x, y) = if x then y else y + 2
    in
      fn z => fn L => foldr f z L
    end
  \end{codeblock}

  \textbf{Type:} \begin{solutionorlines}[4em]
    \code{f} has type \code{(bool * int) -> int}, therefore
    \code{int -> bool list -> int} \end{solutionorlines}

  \textbf{Value:} \begin{solutionorlines}[4em] \code{fn z => fn L => foldr f z L} \end{solutionorlines}
\end{parts}

